# Copy this file to .env and fill in the values. Never commit .env.
# On Vercel, add the same names under Settings → Environment Variables.
GEMINI_API_KEY=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Live FAQ from Google Sheet (File → Share → Publish to web → CSV). Comma-separate several tabs.
SHEET_CSV_URL=
# Optional
# GEMINI_MODELS=gemini-3.5-flash,gemini-3.8-flash,gemini-3.1-flash-lite
# UPSTASH_REDIS_REST_URL= / UPSTASH_REDIS_REST_TOKEN=  (added automatically when you connect Upstash in Vercel)
